/** שורות לדוגמה: מבדק התא (נוסחים A, B, C). נוצר על ידי tools/export-sample.js */
var SAMPLE_ROWS = [["נוסח","סוג","מספר","טקסט","פרטים","ניקוד","תבחינים","תשובה לדוגמה","הסבר","יכולת","תמונה"],["A","יחידה",1,"שבלול הים שמצטלם כמו עלה","שאלות 1–5 עוסקות באברונים בתאים של שבלול ים ובהישרדות שלו.","","","","","",""],["A","פסקה","","אליסיה כלורוטיקה הוא שבלול ים קטן שחי בביצות מלח בחוף המזרחי של ארצות הברית. שבלולים צעירים ניזונים מאצות: הם מוצצים את תוכן התאים של האצה. את רוב החומרים שבתאי האצה השבלול מפרק ומעכל, אבל הכלורופלסטים של האצה אינם מתעכלים. הם נכנסים לתאים שמצפים את מערכת העיכול של השבלול, ונשארים שם שלמים ופעילים חודשים רבים. מאז השבלול הופך לירוק.","","","","","","",""],["A","פסקה","","לאחר זמן, השבלולים הבוגרים מפסיקים לאכול אצות לגמרי. כשהם נמצאים באור, הם ממשיכים לחיות חודשים רבים.","","","","","","",""],["A","איור","","<svg viewBox=\"0 0 620 400\" role=\"img\" aria-label=\"תא ממערכת העיכול של שבלול הים ובו שלושה חלקים מסומנים במספרים 1, 2 ו-3\"><ellipse cx=\"310\" cy=\"205\" rx=\"260\" ry=\"150\" fill=\"#fbf3e4\" stroke=\"#5a4a35\" stroke-width=\"5\"/><g transform=\"translate(165 150) rotate(-25)\"><ellipse rx=\"46\" ry=\"23\" fill=\"#7bc96f\" stroke=\"#2f7a2b\" stroke-width=\"3\"/><rect x=\"-30\" y=\"-9\" width=\"14\" height=\"18\" rx=\"3\" fill=\"#3f9a3a\"/><rect x=\"-7\" y=\"-9\" width=\"14\" height=\"18\" rx=\"3\" fill=\"#3f9a3a\"/><rect x=\"16\" y=\"-9\" width=\"14\" height=\"18\" rx=\"3\" fill=\"#3f9a3a\"/></g><g transform=\"translate(455 270) rotate(-20)\"><ellipse rx=\"46\" ry=\"23\" fill=\"#7bc96f\" stroke=\"#2f7a2b\" stroke-width=\"3\"/><rect x=\"-30\" y=\"-9\" width=\"14\" height=\"18\" rx=\"3\" fill=\"#3f9a3a\"/><rect x=\"-7\" y=\"-9\" width=\"14\" height=\"18\" rx=\"3\" fill=\"#3f9a3a\"/><rect x=\"16\" y=\"-9\" width=\"14\" height=\"18\" rx=\"3\" fill=\"#3f9a3a\"/></g><g transform=\"translate(185 282) rotate(15)\"><ellipse rx=\"46\" ry=\"23\" fill=\"#7bc96f\" stroke=\"#2f7a2b\" stroke-width=\"3\"/><rect x=\"-30\" y=\"-9\" width=\"14\" height=\"18\" rx=\"3\" fill=\"#3f9a3a\"/><rect x=\"-7\" y=\"-9\" width=\"14\" height=\"18\" rx=\"3\" fill=\"#3f9a3a\"/><rect x=\"16\" y=\"-9\" width=\"14\" height=\"18\" rx=\"3\" fill=\"#3f9a3a\"/></g><g transform=\"translate(440 145) rotate(25)\"><rect x=\"-38\" y=\"-18\" width=\"76\" height=\"36\" rx=\"18\" fill=\"#f4a259\" stroke=\"#b4631a\" stroke-width=\"3\"/><path d=\"M-24 0 Q-16 -13 -9 0 T6 0 T22 0\" fill=\"none\" stroke=\"#b4631a\" stroke-width=\"3\" stroke-linecap=\"round\"/></g><g transform=\"translate(300 318) rotate(-8)\"><rect x=\"-38\" y=\"-18\" width=\"76\" height=\"36\" rx=\"18\" fill=\"#f4a259\" stroke=\"#b4631a\" stroke-width=\"3\"/><path d=\"M-24 0 Q-16 -13 -9 0 T6 0 T22 0\" fill=\"none\" stroke=\"#b4631a\" stroke-width=\"3\" stroke-linecap=\"round\"/></g><circle cx=\"310\" cy=\"205\" r=\"55\" fill=\"#d6def5\" stroke=\"#3d3a8c\" stroke-width=\"3\"/><circle cx=\"324\" cy=\"197\" r=\"16\" fill=\"#9aa6dd\"/><line x1=\"310\" y1=\"30\" x2=\"310\" y2=\"150\" stroke=\"#1c1c28\" stroke-width=\"2\"/><circle cx=\"310\" cy=\"30\" r=\"18\" fill=\"#fff\" stroke=\"#1c1c28\" stroke-width=\"2.5\"/><text x=\"310\" y=\"37\" text-anchor=\"middle\" font-size=\"21\" font-weight=\"700\" fill=\"#1c1c28\" font-family=\"Heebo,Arial,sans-serif\">1</text><line x1=\"58\" y1=\"66\" x2=\"138\" y2=\"138\" stroke=\"#1c1c28\" stroke-width=\"2\"/><circle cx=\"58\" cy=\"66\" r=\"18\" fill=\"#fff\" stroke=\"#1c1c28\" stroke-width=\"2.5\"/><text x=\"58\" y=\"73\" text-anchor=\"middle\" font-size=\"21\" font-weight=\"700\" fill=\"#1c1c28\" font-family=\"Heebo,Arial,sans-serif\">2</text><line x1=\"562\" y1=\"66\" x2=\"462\" y2=\"130\" stroke=\"#1c1c28\" stroke-width=\"2\"/><circle cx=\"562\" cy=\"66\" r=\"18\" fill=\"#fff\" stroke=\"#1c1c28\" stroke-width=\"2.5\"/><text x=\"562\" y=\"73\" text-anchor=\"middle\" font-size=\"21\" font-weight=\"700\" fill=\"#1c1c28\" font-family=\"Heebo,Arial,sans-serif\">3</text></svg>","תרשים 1: תא ממערכת העיכול של שבלול הים (תרשים סכמטי)","","","","תא של שבלול ים ובו שלושה חלקים מסומנים במספרים","",""],["A","שאלה",1,"בתרשים 1 מסומנים שלושה חלקים של התא. כתבו בטבלה את שמו של כל חלק ואת תפקידו.","טבלת שם ותפקיד: כותרות=מספר בתרשים|שם החלק|תפקיד החלק בתא ;; 1=גרעין|מכיל את החומר התורשתי (כרומוזומים) ושולט בפעילות התא. ;; 2=כלורופלסט|בעזרת אור הוא מייצר סוכר (מזון) לתא. התהליך נקרא פוטוסינתזה. ;; 3=מיטוכונדר|מפיקה אנרגיה מסוכר וחמצן (נשימה תאית).",6,"","","החלק המסומן 1 הוא הגרעין.","ידע ומודלים",""],["A","שאלה",2,"תאי השבלול הם תאי בעל חיים. בתאי האצה יש חלק שמקנה להם צורה קבועה וקשיחה, והוא אינו קיים בתאי בעלי חיים, וגם לא בתא השבלול שבתרשים. איזה חלק זה?","בחירה: קרום התא | *דופן התא | ציטופלסמה | גרעין",4,"","","דופן התא קיימת בתאי צמח ובתאי אצה ומקנה להם צורה קבועה. בתאי בעלי חיים אין דופן. קרום התא קיים בכל התאים.","ידע ומודלים",""],["A","שאלה",3,"השבלול הבוגר אינו אוכל אצות חודשים רבים, ובכל זאת הוא נשאר בחיים כשהוא נמצא באור. היעזרו בקטע ובתרשים 1, והסבירו מאיפה התאים של השבלול מקבלים מזון.","פתוחה: שורות=4",10,"4 נק׳: בתאי השבלול יש כלורופלסטים (שנלקחו מהאצה). 4 נק׳: הכלורופלסטים מייצרים מזון/סוכר בעזרת אור (פוטוסינתזה; אין חובה להשתמש במילה). 2 נק׳: זה קורה רק באור (בחושך אין ייצור מזון).","בתאי השבלול נשארו כלורופלסטים של האצה. כשהשבלול באור, הכלורופלסטים מייצרים סוכר (מזון) מאור, בפוטוסינתזה, והתאים משתמשים בו. בחושך אין ייצור מזון.","","הסבר תופעות",""],["A","פסקה","","חוקרים רצו לבדוק אם האור חשוב להישרדות של שבלולים בוגרים שהפסיקו לאכול אצות. הם חילקו 40 שבלולים כאלה לשתי קבוצות של 20 שבלולים כל אחת. קבוצה אחת הוחזקה באור יום, והקבוצה השנייה הוחזקה בחושך. שאר התנאים (טמפרטורת המים, מליחות המים) היו זהים בשתי הקבוצות. כל שבועיים החוקרים ספרו כמה שבלולים נשארו בחיים. התוצאות מוצגות בגרף 1.","","","","","","",""],["A","גרף","","גרף 1: אחוז השבלולים שנשארו בחיים, לפי זמן וסוג התאורה","xt=זמן מתחילת הניסוי (שבועות) ;; yt=שבלולים שנשארו בחיים (%) ;; ymin=0 ;; ymax=100 ;; ystep=20 ;; x=0,2,4,6,8,10 ;; קו:קבוצה באור=100,100,100,95,95,90 ;; מקווקו:קבוצה בחושך=100,95,70,40,10,0","","","","הנתונים מותאמים לצורך המבדק.","",""],["A","שאלה",4,"איזו מסקנה נתמכת בנתוני גרף 1?","בחירה: שבלולים הנמצאים בחושך מתים בתוך שבועיים מהרגע שהפסיקו לאכול אצות. | כל השבלולים שהוחזקו באור נשארו בחיים עד סוף הניסוי, בלי יוצא מן הכלל. | *האור מאפשר לשבלולים בוגרים לשרוד זמן רב יותר בלי לאכול אצות. | בחושך הכלורופלסטים שבתאי השבלולים נהרסים, ולכן השבלולים מתים.",4,"","","בגרף רואים שבאור שרדו כמעט כל השבלולים, ובחושך מספרם ירד מהר. לכן המסקנה הנתמכת היא שהאור מאפשר לשרוד זמן רב יותר בלי אצות. שאר המסקנות אינן נתמכות בנתונים: בחושך לא כולם מתו בתוך שבועיים, באור לא כולם שרדו, ולא נבדק מה קרה לכלורופלסטים.","פרשנות נתונים",""],["A","שאלה",5,"אחד החוקרים טוען: \"הניסוי מוכיח שהכלורופלסטים הם שמאפשרים לשבלולים לשרוד באור\". חוקרת אחרת אומרת: \"הניסוי אינו מוכיח זאת, ואפשר להוסיף לו קבוצה נוספת\".<br>הציעו קבוצה נוספת שאפשר להוסיף לניסוי כדי לבדוק את הטענה על הכלורופלסטים, והסבירו איזו תוצאה תחזק את הטענה.","פתוחה: שורות=5",12,"4 נק׳: קבוצה של שבלולים שאין בתאיהם כלורופלסטים (למשל שמעולם לא אכלו אצות). 4 נק׳: הקבוצה מוחזקת באור, ושאר התנאים זהים. 4 נק׳: אם הם מתים כמו הקבוצה שבחושך גם באור, סימן שהאור לבדו לא מספיק והכלורופלסטים חיוניים. הצעה נכונה בלי הסבר: עד 8.","אפשר להוסיף קבוצה של שבלולים שאין בתאיהם כלורופלסטים (למשל כאלה שמעולם לא אכלו אצות) ולהחזיק אותם באור, בתנאים זהים. אם הם מתים כמו הקבוצה שבחושך, סימן שהאור לבדו אינו מספיק והכלורופלסטים הם שמאפשרים לשרוד.","","תכנון והערכת מחקר",""],["A","יחידה",2,"כמה כרומוזומים?","שאלות 6–10 עוסקות במספר הכרומוזומים בתאים ובחלוקות של תאים.","","","","","",""],["A","פסקה","","בגרעין של כל תא גוף נמצאים כרומוזומים, ובהם החומר התורשתי. מספר הכרומוזומים בתאי הגוף קבוע בכל מין: למשל, בתא עור ובתא שריר של אדם יש אותו מספר כרומוזומים. חוקרים ספרו את הכרומוזומים בתא גוף של כמה מינים. התוצאות מוצגות בטבלה 1.","","","","","","",""],["A","טבלה","","טבלה 1: מספר הכרומוזומים בתא גוף","המין|זבוב פירות|אפונה|חתול|אדם|שימפנזה|תפוח אדמה|כלב ;; מספר הכרומוזומים בתא גוף|8|14|38|46|48|48|78","","","","","",""],["A","פסקה","","תאי רבייה (תא זרע וביצית) נוצרים בחלוקה מיוחדת שנקראת מיוזה. בכל תא רבייה יש מחצית ממספר הכרומוזומים של תא גוף. בהפריה תא זרע מתמזג עם ביצית, ונוצרת ביצית מופרית (זיגוטה), שבה יש מספר הכרומוזומים של תא גוף.","","","","","","",""],["A","שאלה",6,"כמה כרומוזומים יש בתא ביצית של כלבה?","בחירה: 156 | 78 | *39 | 20",4,"","","בתא רבייה יש מחצית ממספר הכרומוזומים של תא גוף: 78 חלקי 2 הם 39.","ידע ומודלים",""],["A","שאלה",7,"בתא גוף של זבוב פירות יש 8 כרומוזומים. כתבו בטבלה כמה כרומוזומים יש בכל אחד מהתאים.","טבלת מספרים: כותרות=התא|מספר הכרומוזומים ;; תא עור חדש שנוצר בחלוקת מיטוזה של תא עור של זבוב=8 ;; ביצית של נקבת זבוב=4 ;; ביצית מופרית (זיגוטה) של זבוב=8",6,"","","מיטוזה יוצרת תאים זהים לתא האם, ולכן יש בהם 8 כרומוזומים.","ידע ומודלים",""],["A","שאלה",8,"הסבירו מדוע חשוב שבתאי הרבייה יהיה מספר כרומוזומים קטן בחצי ממספרם בתא גוף. היעזרו בנתון על האדם בטבלה 1.","פתוחה: שורות=5",10,"3 נק׳: בהפריה תא הזרע והביצית מתמזגים והביצית המופרית מקבלת כרומוזומים משניהם. 4 נק׳: אילו בכל תא רבייה היו 46 כרומוזומים, בביצית המופרית היו 92 ולא 46. 3 נק׳: מספר הכרומוזומים היה מוכפל בכל דור, ובמין צריך להישמר מספר קבוע. תשובה כללית בלי הנתון: עד 6.","בהפריה תא הזרע והביצית מתמזגים. אילו בכל אחד מהם היו 46 כרומוזומים, בביצית המופרית היו 92, והמספר היה מוכפל בכל דור. מיוזה יוצרת תאי רבייה עם מחצית מהכרומוזומים, ולכן מספר הכרומוזומים נשאר קבוע במין.","","הסבר תופעות",""],["A","שאלה",9,"גל טוענת: \"ככל שליצור חי יש יותר כרומוזומים, כך הוא מורכב ומפותח יותר\".<br>האם הנתונים בטבלה 1 תומכים בטענה? נמקו, והשתמשו בנתונים של שני מינים לפחות.","פתוחה: שורות=5",10,"3 נק׳: הנתונים אינם תומכים בטענה. 4 נק׳: דוגמה נגדית מהטבלה, 2 נק׳ לכל דוגמה (למשל תפוח אדמה 48 מול אדם 46, או כלב 78 מול אדם 46). 3 נק׳: מספר הכרומוזומים לבדו אינו מעיד על מורכבות או התפתחות. הסכמה עם הטענה: 0.","לא. בטבלה לתפוח אדמה יש 48 כרומוזומים, יותר מאשר לאדם (46), ולכלב 78, ובכל זאת אין סיבה לחשוב שהם מורכבים ומפותחים יותר מאדם. מספר הכרומוזומים לבדו אינו מעיד על מורכבות.","","חשיבה ביקורתית",""],["A","פסקה","","כשיש פצע בעור, תאי עור מתחלקים במיטוזה וסוגרים אותו. חוקרים גידלו בצלחת מעבדה תא עור אחד. בכל יום כל תא בצלחת התחלק פעם אחת לשני תאי בת. התוצאות של שלושת הימים הראשונים מוצגות בטבלה 2.","","","","","","",""],["A","טבלה","","טבלה 2: מספר תאי העור בצלחת","היום|0|1|2|3 ;; מספר התאים בצלחת|1|2|4|8","","","","","",""],["A","שאלה",10,"אם החלוקות ימשיכו באותו קצב, כמה תאי עור יהיו בצלחת ביום 5?","בחירה: 10 | 16 | 25 | *32",4,"","","בכל יום כל תא מתחלק לשניים, ולכן מספר התאים מוכפל: 1, 2, 4, 8, 16, 32, 64. זו הכפלה ולא הוספה של אותו מספר בכל יום.","פרשנות נתונים",""],["A","יחידה",3,"אתלט בהרים","שאלות 11–14 עוסקות בתאי דם אדומים, בתאי שריר וברמות הארגון בגוף.","","","","","",""],["A","פסקה","","באוויר שבהרים גבוהים יש פחות חמצן מאשר בגובה פני הים. אתלטים רבים מתאמנים בהרים, כי אחרי כמה שבועות הגוף שלהם מייצר יותר תאי דם אדומים.","","","","","","",""],["A","פסקה","","תא דם אדום הוא תא קטן וגמיש, ואין בו גרעין. הוא מלא בחלבון שקושר חמצן. תאי הדם האדומים נעים בכלי הדם ומובילים חמצן מהריאות אל תאי הגוף. בתאי שריר המיטוכונדריות משתמשות בחמצן ובסוכר כדי לשחרר אנרגיה לכיווץ השריר.","","","","","","",""],["A","פסקה","","חוקרים בדקו שתי קבוצות של רצים. קבוצה אחת התאמנה ארבעה שבועות בהרים, והקבוצה השנייה התאמנה אותו אימון בגובה פני הים. התוצאות מוצגות בטבלה 3.","","","","","","",""],["A","טבלה","","טבלה 3: תאי דם אדומים וזמן ריצה של 5 ק״מ","הקבוצה|תאי דם אדומים לפני האימון (מיליונים במיקרוליטר)|תאי דם אדומים אחרי 4 שבועות|זמן ריצה לפני האימון (דקות)|זמן ריצה אחרי 4 שבועות (דקות) ;; אימון בהרים|5.0|5.6|20.0|19.0 ;; אימון בגובה פני הים|5.0|5.0|20.0|19.8","","","","הנתונים מותאמים לצורך המבדק.","",""],["A","שאלה",11,"אחד המאפיינים של תא דם אדום הוא שאין בו גרעין. איזה יתרון יש לכך להובלת חמצן?","בחירה: התא מפיק אנרגיה מחמצן גם בלי מיטוכונדריות, ולכן אינו זקוק לגרעין. | *נוצר בתא מקום לכמות גדולה של חלבון שקושר חמצן. | התא יכול להתחלק מהר יותר, ולכן מספר תאי הדם האדומים גדל. | הגרעין היה חוסם את כניסת החמצן אל התא.",4,"","","כשאין גרעין נשאר בתא יותר מקום לחלבון שקושר חמצן, ולכן התא יכול להוביל יותר חמצן.","הסבר תופעות",""],["A","שאלה",12,"היעזרו בקטע ובטבלה 3, ובחרו מכל רשימה את המילה המתאימה להשלמת ההסבר: כיצד האימון בהרים עזר לרצים לרוץ מהר יותר?","השלמה: אצל הרצים שהתאמנו בהרים מספר תאי הדם האדומים {*גדל|קטן|לא השתנה} . לכן לתאי השריר מגיעה {*יותר חמצן|פחות חמצן|אותה כמות חמצן בדיוק} . המיטוכונדריות בתאי השריר משתמשות בחמצן ובסוכר כדי לשחרר {*אנרגיה|חומר תורשתי|חלבונים} , ולכן הרצים יכולים להתכווץ ולרוץ בעוצמה גבוהה יותר, וזמן הריצה שלהם {*התקצר|התארך|לא השתנה} .",8,"","","בטבלה מספר תאי הדם האדומים בקבוצת ההרים עלה.","הסבר תופעות",""],["A","שאלה",13,"בגוף יש רמות ארגון שונות: תא, רקמה, איבר ומערכת איברים. סמנו בכל שורה לאיזו רמת ארגון שייך הפריט.","מטריצה: עמודות=תא|רקמה|איבר|מערכת איברים ;; תא דם אדום אחד=תא ;; קבוצת תאי שריר דומים שמתכווצים יחד=רקמה ;; הלב=איבר ;; הריאות=איבר ;; הלב, כלי הדם והדם יחד=מערכת איברים",10,"","","תא הוא היחידה הקטנה ביותר. קבוצת תאים דומים הפועלים יחד היא רקמה. כמה רקמות יוצרות איבר, וכמה איברים הפועלים יחד הם מערכת איברים.","ידע ומודלים",""],["A","פסקה","","בפרסומת לתוסף תזונה כתוב:","","","","","","",""],["A","פסקה","","<b>\"התוסף שלנו מגדיל את מספר תאי הדם האדומים! אתלט מפורסם התאמן איתו ושבר שיא עולמי!\"</b>","","","","","","",""],["A","שאלה",14,"א. כתבו חולשה אחת בראיה שמוצגת בפרסומת.<br>ב. כתבו מה היה צריך לדעת או לבדוק כדי להעריך אם התוסף באמת עוזר.","פתוחה: שורות=3; תווית=א",4,"חולשה אחת מקובלת: אתלט/ית אחד/ת בלבד, אין קבוצת בקרה, אין נתונים מספריים, ייתכן שהשיא נובע מאימון או כישרון ולא מהתוסף, ייתכן שהפרסומת ממומנת.","בפרסומת מוצג אדם אחד בלבד, בלי קבוצת בקרה ובלי נתונים. לא ידוע אם השיא נבע מהתוסף או מאימון או מכישרון.","","חשיבה ביקורתית",""],["A","שאלה",14,"","פתוחה: שורות=3; תווית=ב",4,"הצעה מתאימה: בדיקה בקבוצה גדולה, חלקה נוטלת את התוסף וחלקה תכשיר בלי חומר פעיל, אותו אימון, מדידה לפני ואחרי. מקובל גם: לברר מי מימן את הבדיקה.","כדאי לבדוק קבוצה גדולה, חלקה עם התוסף וחלקה עם תכשיר בלי חומר פעיל, באותו אימון, ולמדוד לפני ואחרי. וגם לברר מי מימן את הבדיקה.","","",""],["B","יחידה",1,"שבלול הים שמצטלם כמו עלה","שאלות 1–5 עוסקות באברונים בתאים של שבלול ים ובהישרדות שלו.","","","","","",""],["B","פסקה","","אליסיה כלורוטיקה הוא שבלול ים קטן שחי בביצות מלח בחוף המזרחי של ארצות הברית. שבלולים צעירים ניזונים מאצות: הם מוצצים את תוכן התאים של האצה. את רוב החומרים שבתאי האצה השבלול מפרק ומעכל, אבל הכלורופלסטים של האצה אינם מתעכלים. הם נכנסים לתאים שמצפים את מערכת העיכול של השבלול, ונשארים שם שלמים ופעילים חודשים רבים. מאז השבלול הופך לירוק.","","","","","","",""],["B","פסקה","","לאחר זמן, השבלולים הבוגרים מפסיקים לאכול אצות לגמרי. כשהם נמצאים באור, הם ממשיכים לחיות חודשים רבים.","","","","","","",""],["B","איור","","<svg viewBox=\"0 0 620 400\" role=\"img\" aria-label=\"תא ממערכת העיכול של שבלול הים ובו שלושה חלקים מסומנים במספרים 1, 2 ו-3\"><ellipse cx=\"310\" cy=\"205\" rx=\"260\" ry=\"150\" fill=\"#fbf3e4\" stroke=\"#5a4a35\" stroke-width=\"5\"/><g transform=\"translate(165 150) rotate(-25)\"><ellipse rx=\"46\" ry=\"23\" fill=\"#7bc96f\" stroke=\"#2f7a2b\" stroke-width=\"3\"/><rect x=\"-30\" y=\"-9\" width=\"14\" height=\"18\" rx=\"3\" fill=\"#3f9a3a\"/><rect x=\"-7\" y=\"-9\" width=\"14\" height=\"18\" rx=\"3\" fill=\"#3f9a3a\"/><rect x=\"16\" y=\"-9\" width=\"14\" height=\"18\" rx=\"3\" fill=\"#3f9a3a\"/></g><g transform=\"translate(455 270) rotate(-20)\"><ellipse rx=\"46\" ry=\"23\" fill=\"#7bc96f\" stroke=\"#2f7a2b\" stroke-width=\"3\"/><rect x=\"-30\" y=\"-9\" width=\"14\" height=\"18\" rx=\"3\" fill=\"#3f9a3a\"/><rect x=\"-7\" y=\"-9\" width=\"14\" height=\"18\" rx=\"3\" fill=\"#3f9a3a\"/><rect x=\"16\" y=\"-9\" width=\"14\" height=\"18\" rx=\"3\" fill=\"#3f9a3a\"/></g><g transform=\"translate(185 282) rotate(15)\"><ellipse rx=\"46\" ry=\"23\" fill=\"#7bc96f\" stroke=\"#2f7a2b\" stroke-width=\"3\"/><rect x=\"-30\" y=\"-9\" width=\"14\" height=\"18\" rx=\"3\" fill=\"#3f9a3a\"/><rect x=\"-7\" y=\"-9\" width=\"14\" height=\"18\" rx=\"3\" fill=\"#3f9a3a\"/><rect x=\"16\" y=\"-9\" width=\"14\" height=\"18\" rx=\"3\" fill=\"#3f9a3a\"/></g><g transform=\"translate(440 145) rotate(25)\"><rect x=\"-38\" y=\"-18\" width=\"76\" height=\"36\" rx=\"18\" fill=\"#f4a259\" stroke=\"#b4631a\" stroke-width=\"3\"/><path d=\"M-24 0 Q-16 -13 -9 0 T6 0 T22 0\" fill=\"none\" stroke=\"#b4631a\" stroke-width=\"3\" stroke-linecap=\"round\"/></g><g transform=\"translate(300 318) rotate(-8)\"><rect x=\"-38\" y=\"-18\" width=\"76\" height=\"36\" rx=\"18\" fill=\"#f4a259\" stroke=\"#b4631a\" stroke-width=\"3\"/><path d=\"M-24 0 Q-16 -13 -9 0 T6 0 T22 0\" fill=\"none\" stroke=\"#b4631a\" stroke-width=\"3\" stroke-linecap=\"round\"/></g><circle cx=\"310\" cy=\"205\" r=\"55\" fill=\"#d6def5\" stroke=\"#3d3a8c\" stroke-width=\"3\"/><circle cx=\"324\" cy=\"197\" r=\"16\" fill=\"#9aa6dd\"/><line x1=\"310\" y1=\"30\" x2=\"310\" y2=\"150\" stroke=\"#1c1c28\" stroke-width=\"2\"/><circle cx=\"310\" cy=\"30\" r=\"18\" fill=\"#fff\" stroke=\"#1c1c28\" stroke-width=\"2.5\"/><text x=\"310\" y=\"37\" text-anchor=\"middle\" font-size=\"21\" font-weight=\"700\" fill=\"#1c1c28\" font-family=\"Heebo,Arial,sans-serif\">1</text><line x1=\"58\" y1=\"66\" x2=\"138\" y2=\"138\" stroke=\"#1c1c28\" stroke-width=\"2\"/><circle cx=\"58\" cy=\"66\" r=\"18\" fill=\"#fff\" stroke=\"#1c1c28\" stroke-width=\"2.5\"/><text x=\"58\" y=\"73\" text-anchor=\"middle\" font-size=\"21\" font-weight=\"700\" fill=\"#1c1c28\" font-family=\"Heebo,Arial,sans-serif\">2</text><line x1=\"562\" y1=\"66\" x2=\"462\" y2=\"130\" stroke=\"#1c1c28\" stroke-width=\"2\"/><circle cx=\"562\" cy=\"66\" r=\"18\" fill=\"#fff\" stroke=\"#1c1c28\" stroke-width=\"2.5\"/><text x=\"562\" y=\"73\" text-anchor=\"middle\" font-size=\"21\" font-weight=\"700\" fill=\"#1c1c28\" font-family=\"Heebo,Arial,sans-serif\">3</text></svg>","תרשים 1: תא ממערכת העיכול של שבלול הים (תרשים סכמטי)","","","","תא של שבלול ים ובו שלושה חלקים מסומנים במספרים","",""],["B","שאלה",1,"בתרשים 1 מסומנים שלושה חלקים של התא. כתבו בטבלה את שמו של כל חלק ואת תפקידו.","טבלת שם ותפקיד: כותרות=מספר בתרשים|שם החלק|תפקיד החלק בתא ;; 1=גרעין|מכיל את החומר התורשתי (כרומוזומים) ושולט בפעילות התא. ;; 2=כלורופלסט|בעזרת אור הוא מייצר סוכר (מזון) לתא. התהליך נקרא פוטוסינתזה. ;; 3=מיטוכונדר|מפיקה אנרגיה מסוכר וחמצן (נשימה תאית).",6,"","","החלק המסומן 1 הוא הגרעין.","ידע ומודלים",""],["B","שאלה",2,"בתאי האצה יש חלק שתומך בתא ושומר על צורתו הקבועה. החלק הזה אינו קיים בתאי בעלי חיים, וגם לא בתא השבלול שבתרשים. איזה חלק זה?","בחירה: קרום התא | *דופן התא | ציטופלסמה | גרעין",4,"","","דופן התא קיימת בתאי צמח ובתאי אצה ומקנה להם צורה קבועה. בתאי בעלי חיים אין דופן. קרום התא קיים בכל התאים.","ידע ומודלים",""],["B","שאלה",3,"השבלול הבוגר אינו אוכל אצות חודשים רבים, ובכל זאת הוא נשאר בחיים כשהוא נמצא באור. היעזרו בקטע ובתרשים 1, והסבירו מאיפה התאים של השבלול מקבלים מזון.","פתוחה: שורות=4",10,"4 נק׳: בתאי השבלול יש כלורופלסטים (שנלקחו מהאצה). 4 נק׳: הכלורופלסטים מייצרים מזון/סוכר בעזרת אור (פוטוסינתזה; אין חובה להשתמש במילה). 2 נק׳: זה קורה רק באור (בחושך אין ייצור מזון).","בתאי השבלול נשארו כלורופלסטים של האצה. כשהשבלול באור, הכלורופלסטים מייצרים סוכר (מזון) מאור, בפוטוסינתזה, והתאים משתמשים בו. בחושך אין ייצור מזון.","","הסבר תופעות",""],["B","פסקה","","חוקרים רצו לבדוק אם האור חשוב להישרדות של שבלולים בוגרים שהפסיקו לאכול אצות. הם חילקו 40 שבלולים כאלה לשתי קבוצות של 20 שבלולים כל אחת. קבוצה אחת הוחזקה באור יום, והקבוצה השנייה הוחזקה בחושך. שאר התנאים (טמפרטורת המים, מליחות המים) היו זהים בשתי הקבוצות. כל שבועיים החוקרים ספרו כמה שבלולים נשארו בחיים. התוצאות מוצגות בגרף 1.","","","","","","",""],["B","גרף","","גרף 1: אחוז השבלולים שנשארו בחיים, לפי זמן וסוג התאורה","xt=זמן מתחילת הניסוי (שבועות) ;; yt=שבלולים שנשארו בחיים (%) ;; ymin=0 ;; ymax=100 ;; ystep=20 ;; x=0,2,4,6,8,10 ;; קו:קבוצה באור=100,100,95,95,90,85 ;; מקווקו:קבוצה בחושך=100,90,60,30,5,0","","","","הנתונים מותאמים לצורך המבדק.","",""],["B","שאלה",4,"איזו מסקנה נתמכת בנתוני גרף 1?","בחירה: שבלולים הנמצאים בחושך מתים בתוך שבועיים מהרגע שהפסיקו לאכול אצות. | כל השבלולים שהוחזקו באור נשארו בחיים עד סוף הניסוי, בלי יוצא מן הכלל. | *האור מאפשר לשבלולים בוגרים לשרוד זמן רב יותר בלי לאכול אצות. | בחושך הכלורופלסטים שבתאי השבלולים נהרסים, ולכן השבלולים מתים.",4,"","","בגרף רואים שבאור שרדו כמעט כל השבלולים, ובחושך מספרם ירד מהר. לכן המסקנה הנתמכת היא שהאור מאפשר לשרוד זמן רב יותר בלי אצות. שאר המסקנות אינן נתמכות בנתונים: בחושך לא כולם מתו בתוך שבועיים, באור לא כולם שרדו, ולא נבדק מה קרה לכלורופלסטים.","פרשנות נתונים",""],["B","שאלה",5,"אחד החוקרים טוען: \"הניסוי מוכיח שהכלורופלסטים הם שמאפשרים לשבלולים לשרוד באור\". חוקרת אחרת אומרת: \"הניסוי אינו מוכיח זאת, ואפשר להוסיף לו קבוצה נוספת\".<br>הציעו קבוצה נוספת שאפשר להוסיף לניסוי כדי לבדוק את הטענה על הכלורופלסטים, והסבירו איזו תוצאה תחזק את הטענה.","פתוחה: שורות=5",12,"4 נק׳: קבוצה של שבלולים שאין בתאיהם כלורופלסטים (למשל שמעולם לא אכלו אצות). 4 נק׳: הקבוצה מוחזקת באור, ושאר התנאים זהים. 4 נק׳: אם הם מתים כמו הקבוצה שבחושך גם באור, סימן שהאור לבדו לא מספיק והכלורופלסטים חיוניים. הצעה נכונה בלי הסבר: עד 8.","אפשר להוסיף קבוצה של שבלולים שאין בתאיהם כלורופלסטים (למשל כאלה שמעולם לא אכלו אצות) ולהחזיק אותם באור, בתנאים זהים. אם הם מתים כמו הקבוצה שבחושך, סימן שהאור לבדו אינו מספיק והכלורופלסטים הם שמאפשרים לשרוד.","","תכנון והערכת מחקר",""],["B","יחידה",2,"כמה כרומוזומים?","שאלות 6–10 עוסקות במספר הכרומוזומים בתאים ובחלוקות של תאים.","","","","","",""],["B","פסקה","","בגרעין של כל תא גוף נמצאים כרומוזומים, ובהם החומר התורשתי. מספר הכרומוזומים בתאי הגוף קבוע בכל מין: למשל, בתא עור ובתא שריר של אדם יש אותו מספר כרומוזומים. חוקרים ספרו את הכרומוזומים בתא גוף של כמה מינים. התוצאות מוצגות בטבלה 1.","","","","","","",""],["B","טבלה","","טבלה 1: מספר הכרומוזומים בתא גוף","המין|זבוב פירות|אפונה|חתול|אדם|שימפנזה|תפוח אדמה|כלב ;; מספר הכרומוזומים בתא גוף|8|14|38|46|48|48|78","","","","","",""],["B","פסקה","","תאי רבייה (תא זרע וביצית) נוצרים בחלוקה מיוחדת שנקראת מיוזה. בכל תא רבייה יש מחצית ממספר הכרומוזומים של תא גוף. בהפריה תא זרע מתמזג עם ביצית, ונוצרת ביצית מופרית (זיגוטה), שבה יש מספר הכרומוזומים של תא גוף.","","","","","","",""],["B","שאלה",6,"כמה כרומוזומים יש בתא ביצית של חתולה?","בחירה: 76 | 38 | *19 | 10",4,"","","בתא רבייה יש מחצית ממספר הכרומוזומים של תא גוף: 38 חלקי 2 הם 19.","ידע ומודלים",""],["B","שאלה",7,"בתא גוף של אפונה יש 14 כרומוזומים. כתבו בטבלה כמה כרומוזומים יש בכל אחד מהתאים.","טבלת מספרים: כותרות=התא|מספר הכרומוזומים ;; תא עלה חדש שנוצר בחלוקת מיטוזה של תא עלה של צמח אפונה=14 ;; ביצית של צמח אפונה=7 ;; ביצית מופרית (זיגוטה) של צמח אפונה=14",6,"","","מיטוזה יוצרת תאים זהים לתא האם, ולכן יש בהם 14 כרומוזומים.","ידע ומודלים",""],["B","שאלה",8,"הסבירו מדוע חשוב שבתאי הרבייה יהיה מספר כרומוזומים קטן בחצי ממספרם בתא גוף. היעזרו בנתון על השימפנזה בטבלה 1.","פתוחה: שורות=5",10,"3 נק׳: בהפריה תא הזרע והביצית מתמזגים והביצית המופרית מקבלת כרומוזומים משניהם. 4 נק׳: אילו בכל תא רבייה היו 48 כרומוזומים, בביצית המופרית היו 96 ולא 48. 3 נק׳: מספר הכרומוזומים היה מוכפל בכל דור, ובמין צריך להישמר מספר קבוע. תשובה כללית בלי הנתון: עד 6.","בהפריה תא הזרע והביצית מתמזגים. אילו בכל אחד מהם היו 48 כרומוזומים, בביצית המופרית היו 96, והמספר היה מוכפל בכל דור. מיוזה יוצרת תאי רבייה עם מחצית מהכרומוזומים, ולכן מספר הכרומוזומים נשאר קבוע במין.","","הסבר תופעות",""],["B","שאלה",9,"מיכל טוענת: \"ככל שליצור חי יש יותר כרומוזומים, כך הוא מורכב ומפותח יותר\".<br>האם הנתונים בטבלה 1 תומכים בטענה? נמקו, והשתמשו בנתונים של שני מינים לפחות.","פתוחה: שורות=5",10,"3 נק׳: הנתונים אינם תומכים בטענה. 4 נק׳: דוגמה נגדית מהטבלה, 2 נק׳ לכל דוגמה (למשל תפוח אדמה 48 מול אדם 46, או כלב 78 מול אדם 46). 3 נק׳: מספר הכרומוזומים לבדו אינו מעיד על מורכבות או התפתחות. הסכמה עם הטענה: 0.","לא. בטבלה לתפוח אדמה יש 48 כרומוזומים, יותר מאשר לאדם (46), ולכלב 78, ובכל זאת אין סיבה לחשוב שהם מורכבים ומפותחים יותר מאדם. מספר הכרומוזומים לבדו אינו מעיד על מורכבות.","","חשיבה ביקורתית",""],["B","פסקה","","כשיש פצע בעור, תאי עור מתחלקים במיטוזה וסוגרים אותו. חוקרים גידלו בצלחת מעבדה תא עור אחד. בכל יום כל תא בצלחת התחלק פעם אחת לשני תאי בת. התוצאות של שלושת הימים הראשונים מוצגות בטבלה 2.","","","","","","",""],["B","טבלה","","טבלה 2: מספר תאי העור בצלחת","היום|0|1|2|3 ;; מספר התאים בצלחת|1|2|4|8","","","","","",""],["B","שאלה",10,"אם החלוקות ימשיכו באותו קצב, כמה תאי עור יהיו בצלחת ביום 6?","בחירה: 12 | 36 | *64 | 128",4,"","","בכל יום כל תא מתחלק לשניים, ולכן מספר התאים מוכפל: 1, 2, 4, 8, 16, 32, 64. זו הכפלה ולא הוספה של אותו מספר בכל יום.","פרשנות נתונים",""],["B","יחידה",3,"אתלט בהרים","שאלות 11–14 עוסקות בתאי דם אדומים, בתאי שריר וברמות הארגון בגוף.","","","","","",""],["B","פסקה","","באוויר שבהרים גבוהים יש פחות חמצן מאשר בגובה פני הים. אתלטים רבים מתאמנים בהרים, כי אחרי כמה שבועות הגוף שלהם מייצר יותר תאי דם אדומים.","","","","","","",""],["B","פסקה","","תא דם אדום הוא תא קטן וגמיש, ואין בו גרעין. הוא מלא בחלבון שקושר חמצן. תאי הדם האדומים נעים בכלי הדם ומובילים חמצן מהריאות אל תאי הגוף. בתאי שריר המיטוכונדריות משתמשות בחמצן ובסוכר כדי לשחרר אנרגיה לכיווץ השריר.","","","","","","",""],["B","פסקה","","חוקרים בדקו שתי קבוצות של רצים. קבוצה אחת התאמנה ארבעה שבועות בהרים, והקבוצה השנייה התאמנה אותו אימון בגובה פני הים. התוצאות מוצגות בטבלה 3.","","","","","","",""],["B","טבלה","","טבלה 3: תאי דם אדומים וזמן ריצה של 5 ק״מ","הקבוצה|תאי דם אדומים לפני האימון (מיליונים במיקרוליטר)|תאי דם אדומים אחרי 4 שבועות|זמן ריצה לפני האימון (דקות)|זמן ריצה אחרי 4 שבועות (דקות) ;; אימון בהרים|4.8|5.5|22.0|20.8 ;; אימון בגובה פני הים|4.8|4.8|22.0|21.8","","","","הנתונים מותאמים לצורך המבדק.","",""],["B","שאלה",11,"אחד המאפיינים של תא דם אדום הוא שאין בו גרעין. איזה יתרון יש לכך להובלת חמצן?","בחירה: התא מפיק אנרגיה מחמצן גם בלי מיטוכונדריות, ולכן אינו זקוק לגרעין. | *נוצר בתא מקום לכמות גדולה של חלבון שקושר חמצן. | התא יכול להתחלק מהר יותר, ולכן מספר תאי הדם האדומים גדל. | הגרעין היה חוסם את כניסת החמצן אל התא.",4,"","","כשאין גרעין נשאר בתא יותר מקום לחלבון שקושר חמצן, ולכן התא יכול להוביל יותר חמצן.","הסבר תופעות",""],["B","שאלה",12,"היעזרו בקטע ובטבלה 3, ובחרו מכל רשימה את המילה המתאימה להשלמת ההסבר: כיצד האימון בהרים עזר לרצים לרוץ מהר יותר?","השלמה: אצל הרצים שהתאמנו בהרים מספר תאי הדם האדומים {*גדל|קטן|לא השתנה} . לכן לתאי השריר מגיעה {*יותר חמצן|פחות חמצן|אותה כמות חמצן בדיוק} . המיטוכונדריות בתאי השריר משתמשות בחמצן ובסוכר כדי לשחרר {*אנרגיה|חומר תורשתי|חלבונים} , ולכן הרצים יכולים להתכווץ ולרוץ בעוצמה גבוהה יותר, וזמן הריצה שלהם {*התקצר|התארך|לא השתנה} .",8,"","","בטבלה מספר תאי הדם האדומים בקבוצת ההרים עלה.","הסבר תופעות",""],["B","שאלה",13,"בגוף יש רמות ארגון שונות: תא, רקמה, איבר ומערכת איברים. סמנו בכל שורה לאיזו רמת ארגון שייך הפריט.","מטריצה: עמודות=תא|רקמה|איבר|מערכת איברים ;; תא עצב אחד=תא ;; קבוצת תאי עצב דומים הפועלים יחד=רקמה ;; המוח=איבר ;; הקיבה=איבר ;; הקיבה, המעיים והכבד, שפועלים יחד בעיכול=מערכת איברים",10,"","","תא הוא היחידה הקטנה ביותר. קבוצת תאים דומים הפועלים יחד היא רקמה. כמה רקמות יוצרות איבר, וכמה איברים הפועלים יחד הם מערכת איברים.","ידע ומודלים",""],["B","פסקה","","בפרסומת לתוסף תזונה כתוב:","","","","","","",""],["B","פסקה","","<b>\"התוסף שלנו מגדיל את מספר המיטוכונדריות בתאי השריר! רצה מפורסמת נטלה אותו ושברה שיא עולמי!\"</b>","","","","","","",""],["B","שאלה",14,"א. כתבו חולשה אחת בראיה שמוצגת בפרסומת.<br>ב. כתבו מה היה צריך לדעת או לבדוק כדי להעריך אם התוסף באמת עוזר.","פתוחה: שורות=3; תווית=א",4,"חולשה אחת מקובלת: אתלט/ית אחד/ת בלבד, אין קבוצת בקרה, אין נתונים מספריים, ייתכן שהשיא נובע מאימון או כישרון ולא מהתוסף, ייתכן שהפרסומת ממומנת.","בפרסומת מוצג אדם אחד בלבד, בלי קבוצת בקרה ובלי נתונים. לא ידוע אם השיא נבע מהתוסף או מאימון או מכישרון.","","חשיבה ביקורתית",""],["B","שאלה",14,"","פתוחה: שורות=3; תווית=ב",4,"הצעה מתאימה: בדיקה בקבוצה גדולה, חלקה נוטלת את התוסף וחלקה תכשיר בלי חומר פעיל, אותו אימון, מדידה לפני ואחרי. מקובל גם: לברר מי מימן את הבדיקה.","כדאי לבדוק קבוצה גדולה, חלקה עם התוסף וחלקה עם תכשיר בלי חומר פעיל, באותו אימון, ולמדוד לפני ואחרי. וגם לברר מי מימן את הבדיקה.","","",""],["C","יחידה",1,"נבטים בחושך","שאלות 1–5 עוסקות בחלקי תא הצמח, באנרגיה בתא ובניסוי עם נבטי שעועית.","","","","","",""],["C","פסקה","","תלמידות שתלו זרעי שעועית בשתי קופסאות זהות, באותה אדמה ובאותה כמות מים. קופסה אחת הוצבה ליד חלון, והשנייה בתוך ארון סגור. אחרי תשעה ימים הנבטים שליד החלון היו ירוקים וגובהם 11 ס״מ. הנבטים שבארון היו צהבהבים וצנומים, וגובהם 16 ס״מ.","","","","","","",""],["C","פסקה","","הצבע הירוק של נבט נובע מחומר ירוק שנמצא באברונים בשם כלורופלסטים. בזרע השעועית יש מלאי מזון: עמילן, שהוא סוכר מאוחסן. בשלב הצמיחה הראשון הנבט משתמש במלאי הזה. התלמידות מדדו גם את המסה היבשה של הנבטים (בלי המים שבהם), פעם בכמה ימים. התוצאות מוצגות בגרף 1.","","","","","","",""],["C","איור","","<svg viewBox=\"0 0 620 400\" role=\"img\" aria-label=\"תא של עלה ובו שלושה חלקים מסומנים במספרים 1, 2 ו-3\"><rect x=\"70\" y=\"50\" width=\"480\" height=\"300\" rx=\"34\" fill=\"#e7f3d4\" stroke=\"#6b4f1d\" stroke-width=\"12\"/><rect x=\"82\" y=\"62\" width=\"456\" height=\"276\" rx=\"26\" fill=\"#f6fbe9\" stroke=\"#8ab062\" stroke-width=\"3\"/><rect x=\"190\" y=\"105\" width=\"300\" height=\"190\" rx=\"70\" fill=\"#d3ecf7\" stroke=\"#4f8fb0\" stroke-width=\"3\"/><g transform=\"translate(135 120) rotate(-20)\"><ellipse rx=\"34\" ry=\"18\" fill=\"#7bc96f\" stroke=\"#2f7a2b\" stroke-width=\"3\"/><rect x=\"-20\" y=\"-7\" width=\"10\" height=\"14\" rx=\"2\" fill=\"#3f9a3a\"/><rect x=\"-4\" y=\"-7\" width=\"10\" height=\"14\" rx=\"2\" fill=\"#3f9a3a\"/><rect x=\"12\" y=\"-7\" width=\"10\" height=\"14\" rx=\"2\" fill=\"#3f9a3a\"/></g><g transform=\"translate(140 285) rotate(15)\"><ellipse rx=\"34\" ry=\"18\" fill=\"#7bc96f\" stroke=\"#2f7a2b\" stroke-width=\"3\"/><rect x=\"-20\" y=\"-7\" width=\"10\" height=\"14\" rx=\"2\" fill=\"#3f9a3a\"/><rect x=\"-4\" y=\"-7\" width=\"10\" height=\"14\" rx=\"2\" fill=\"#3f9a3a\"/><rect x=\"12\" y=\"-7\" width=\"10\" height=\"14\" rx=\"2\" fill=\"#3f9a3a\"/></g><g transform=\"translate(470 90) rotate(10)\"><ellipse rx=\"34\" ry=\"18\" fill=\"#7bc96f\" stroke=\"#2f7a2b\" stroke-width=\"3\"/><rect x=\"-20\" y=\"-7\" width=\"10\" height=\"14\" rx=\"2\" fill=\"#3f9a3a\"/><rect x=\"-4\" y=\"-7\" width=\"10\" height=\"14\" rx=\"2\" fill=\"#3f9a3a\"/><rect x=\"12\" y=\"-7\" width=\"10\" height=\"14\" rx=\"2\" fill=\"#3f9a3a\"/></g><g transform=\"translate(250 318) rotate(-8)\"><ellipse rx=\"34\" ry=\"18\" fill=\"#7bc96f\" stroke=\"#2f7a2b\" stroke-width=\"3\"/><rect x=\"-20\" y=\"-7\" width=\"10\" height=\"14\" rx=\"2\" fill=\"#3f9a3a\"/><rect x=\"-4\" y=\"-7\" width=\"10\" height=\"14\" rx=\"2\" fill=\"#3f9a3a\"/><rect x=\"12\" y=\"-7\" width=\"10\" height=\"14\" rx=\"2\" fill=\"#3f9a3a\"/></g><circle cx=\"520\" cy=\"250\" r=\"26\" fill=\"#d6def5\" stroke=\"#3d3a8c\" stroke-width=\"3\"/><circle cx=\"527\" cy=\"245\" r=\"9\" fill=\"#9aa6dd\"/><line x1=\"40\" y1=\"30\" x2=\"76\" y2=\"62\" stroke=\"#1c1c28\" stroke-width=\"2\"/><circle cx=\"40\" cy=\"30\" r=\"18\" fill=\"#fff\" stroke=\"#1c1c28\" stroke-width=\"2.5\"/><text x=\"40\" y=\"37\" text-anchor=\"middle\" font-size=\"21\" font-weight=\"700\" fill=\"#1c1c28\" font-family=\"Heebo,Arial,sans-serif\">1</text><line x1=\"340\" y1=\"30\" x2=\"340\" y2=\"150\" stroke=\"#1c1c28\" stroke-width=\"2\"/><circle cx=\"340\" cy=\"30\" r=\"18\" fill=\"#fff\" stroke=\"#1c1c28\" stroke-width=\"2.5\"/><text x=\"340\" y=\"37\" text-anchor=\"middle\" font-size=\"21\" font-weight=\"700\" fill=\"#1c1c28\" font-family=\"Heebo,Arial,sans-serif\">2</text><line x1=\"40\" y1=\"200\" x2=\"112\" y2=\"128\" stroke=\"#1c1c28\" stroke-width=\"2\"/><circle cx=\"40\" cy=\"200\" r=\"18\" fill=\"#fff\" stroke=\"#1c1c28\" stroke-width=\"2.5\"/><text x=\"40\" y=\"207\" text-anchor=\"middle\" font-size=\"21\" font-weight=\"700\" fill=\"#1c1c28\" font-family=\"Heebo,Arial,sans-serif\">3</text></svg>","תרשים 1: תא מעלה של נבט שעועית (תרשים סכמטי)","","","","תא של עלה ובו שלושה חלקים מסומנים במספרים","",""],["C","שאלה",1,"בתרשים 1 מסומנים שלושה חלקים של תא העלה. כתבי בטבלה את שמו של כל חלק ואת תפקידו.","טבלת שם ותפקיד: כותרות=מספר בתרשים|שם החלק|תפקיד החלק בתא ;; 1=דופן/קיר|מקנה לתא צורה קבועה ותמיכה, והיא קשיחה. ;; 2=חלולית/חללית/ואקול/וקול|אוגרת מים וחומרים, ומותחת את התא. ;; 3=כלורופלסט/כלורופלסת|מייצר סוכר מאור, בפוטוסינתזה.",6,"","","החלק המסומן 1 הוא דופן התא.","ידע ומודלים",""],["C","שאלה",2,"כשנבט חסר מים, תאיו מאבדים מים והוא נובל ונופל. איזה חלק בתא העלה אוגר מים ומותח את התא?","בחירה: הגרעין של התא | *החלולית הגדולה | המיטוכונדריה בתא | הכלורופלסט הירוק",4,"","","החלולית הגדולה אוגרת מים ומותחת את התא. כשהצמח חסר מים החלולית מתכווצת והצמח נובל.","ידע ומודלים",""],["C","שאלה",3,"נבטי הארון צמחו וגדלו 16 ס״מ, למרות שלא ביצעו פוטוסינתזה. היעזרי בקטע והסבירי מאיפה קיבלו אנרגיה לצמיחה, ובאיזה חלק בתא האנרגיה הזאת שוחררה.","פתוחה: שורות=4",10,"4 נק׳: האנרגיה מגיעה ממלאי המזון שבזרע (עמילן, סוכר). 4 נק׳: במיטוכונדריה משתמשים בסוכר ובחמצן כדי לשחרר אנרגיה (נשימה תאית). 2 נק׳: בחושך אין פוטוסינתזה, ולכן לא נוצר סוכר חדש והמלאי הולך ואוזל. ריק או \"לא יודעת\": 0.","הנבטים השתמשו במלאי המזון שבזרע (עמילן, שהוא סוכר מאוחסן). את האנרגיה שחררו המיטוכונדריות בתאים, שמשתמשות בסוכר ובחמצן. בחושך אין פוטוסינתזה, ולכן לא נוצר סוכר חדש והמלאי נגמר בהדרגה.","","הסבר תופעות",""],["C","גרף","","גרף 1: מסה יבשה ממוצעת של נבט, לפי הימים","xt=זמן מתחילת הניסוי (ימים) ;; yt=מסה יבשה (גרם) ;; ymin=0 ;; ymax=1.6 ;; ystep=0.4 ;; x=0,3,6,9,12 ;; קו:נבטים ליד החלון=1,0.9,0.85,1,1.3 ;; מקווקו:נבטים בארון=1,0.8,0.6,0.45,0.3","","","","הנתונים מותאמים לצורך המבדק.","",""],["C","שאלה",4,"איזו מסקנה נתמכת בנתוני גרף 1?","בחירה: *בנבטי הארון המסה ירדה כל הזמן, כי הם צרכו את המלאי ולא ייצרו מזון. | בנבטי החלון המסה ירדה כל הזמן, ולכן הם צמחו פחות בגובה מנבטי הארון. | נבטי הארון ייצרו יותר מזון מנבטי החלון, ולכן הם גבוהים יותר. | בשני הניסויים המסה עלתה בעקביות מהיום הראשון ועד היום האחרון.",4,"","","בגרף רואים שבארון המסה ירדה כל הזמן: הנבטים צרכו את המלאי ולא ייצרו מזון חדש. ליד החלון המסה ירדה בהתחלה ואחר כך עלתה, כי התחילה פוטוסינתזה.","פרשנות נתונים",""],["C","שאלה",5,"סיגל טוענת: \"נבטי הארון גבוהים יותר, ולכן חושך הוא תנאי טוב יותר לצמיחה של שעועית\".<br>האם הנתונים תומכים בטענה של סיגל? נמקי בעזרת הגובה ובעזרת המסה היבשה.","פתוחה: שורות=5",12,"4 נק׳: הנתונים אינם תומכים בטענה. 4 נק׳: מציינת שגובה לבדו אינו מספיק, ומצטטת מהגרף שבנבטי הארון המסה ירדה (0.3 גרם ביום 12) ואילו ליד החלון עלתה (1.3 גרם). 4 נק׳: מסבירה שהנבט בארון התארך מהמלאי שבזרע, ואין לו פוטוסינתזה לייצר מזון חדש, ולכן ימות כשהמלאי ייגמר. ריק או \"לא יודעת\": 0.","הנתונים אינם תומכים בטענה. נבטי הארון אמנם גבוהים (16 ס״מ), אבל המסה היבשה שלהם יורדת כל הזמן, עד 0.3 גרם ביום 12, ואילו ליד החלון היא עולה ל-1.3 גרם. נבטי הארון התארכו מהמלאי שבזרע, בלי פוטוסינתזה, ולכן לא ייצרו מזון חדש וימותו כשהמלאי ייגמר.","","חשיבה ביקורתית",""],["C","יחידה",2,"פרד ומספר הכרומוזומים","שאלות 6–10 עוסקות במספר כרומוזומים, בהפריה ובחלוקות של תאים.","","","","","",""],["C","פסקה","","בגרעין של כל תא גוף נמצאים כרומוזומים. מספר הכרומוזומים בתא גוף קבוע בכל מין. תאי רבייה (זרע וביצית) מכילים מחצית ממספר הכרומוזומים של תא גוף, ובהפריה הם מתמזגים לביצית מופרית. פרד הוא בעל חיים שנולד מסוסה ומחמור. בטבלה 1 מופיע מספר הכרומוזומים בתא גוף של כמה בעלי חיים.","","","","","","",""],["C","טבלה","","טבלה 1: מספר הכרומוזומים בתא גוף","בעל החיים|סוס|חמור|פרד|כבשה|פרה|אדם ;; מספר הכרומוזומים בתא גוף|64|62|63|54|60|46","","","","","",""],["C","שאלה",6,"כמה כרומוזומים יש בתא ביצית של סוסה?","בחירה: 64 | *32 | 16 | 128",4,"","","בתא ביצית יש מחצית ממספר הכרומוזומים של תא גוף: 64 חלקי 2 הם 32.","ידע ומודלים",""],["C","שאלה",7,"כתבי בטבלה כמה כרומוזומים יש בכל אחד מהתאים.","טבלת מספרים: כותרות=התא|מספר הכרומוזומים ;; תא זרע של חמור=31 ;; תא ביצית של סוסה=32 ;; הביצית המופרית שממנה התפתח פרד=63",6,"","","תא זרע מכיל מחצית ממספר הכרומוזומים של תא גוף: 62 חלקי 2 הם 31.","ידע ומודלים",""],["C","שאלה",8,"תא עור של פרד נוצר בחלוקה של תא עור אחר של אותו פרד. כמה כרומוזומים יש בתא העור החדש? הסבירי מדוע.","פתוחה: שורות=4",10,"3 נק׳: בתא עור חדש של פרד יש 63 כרומוזומים. 4 נק׳: תא עור חדש נוצר במיטוזה, ובמיטוזה נוצרים תאי בת זהים לתא האם. 3 נק׳: לפני החלוקה הכרומוזומים מועתקים, ולכן כל תא בת מקבל קבוצה מלאה של כרומוזומים. ריק או \"לא יודעת\": 0.","בתא עור חדש יש 63 כרומוזומים. תא עור חדש נוצר במיטוזה, ובמיטוזה נוצרים תאי בת זהים לתא האם. לפני החלוקה הכרומוזומים מועתקים, ולכן כל תא בת מקבל קבוצה מלאה ויש בו אותו מספר כרומוזומים כמו בתא האם.","","הסבר תופעות",""],["C","פסקה","","תאים בגוף מתחלפים כל הזמן: תאים ישנים מתים ובמקומם נוצרים תאים חדשים בחלוקות מיטוזה. בטבלה 2 מוצג משך החיים הממוצע של כמה סוגי תאים בגוף האדם.","","","","","","",""],["C","טבלה","","טבלה 2: משך חיים ממוצע של תא","סוג התא|תא בציפוי המעי|תא עור|תא דם אדום|תא עצב בקליפת המוח ;; משך חיים ממוצע|כ-5 ימים|כ-30 ימים|כ-120 ימים|עשרות שנים","","","","הנתונים מעוגלים ומותאמים לצורך המבדק.","",""],["C","שאלה",9,"גילי טוענת: \"כל התאים בגוף מתחלפים באותה מהירות, כי לכולם אותו חומר תורשתי\".<br>האם הנתונים בטבלה 2 תומכים בטענה של גילי? נמקי, והשתמשי בנתונים של שני סוגי תאים לפחות.","פתוחה: שורות=5",10,"3 נק׳: הנתונים אינם תומכים בטענה. 4 נק׳: דוגמאות עם מספרים, 2 נק׳ לכל דוגמה (למשל תא בציפוי המעי כ-5 ימים מול תא דם אדום כ-120 ימים, או תא עור כ-30 ימים מול תא עצב עשרות שנים). 3 נק׳: הסבר: לתאים שונים תפקידים שונים, ולכן הם מתחלפים בקצב שונה, אף שבכולם אותו חומר תורשתי. הסכמה עם הטענה או ריק: 0.","הנתונים אינם תומכים בטענה. תא בציפוי המעי חי כ-5 ימים בלבד ותא דם אדום כ-120 ימים, ותא עצב בקליפת המוח חי עשרות שנים. גם אם לכל התאים אותו חומר תורשתי, תאים מסוגים שונים מבצעים תפקידים שונים ולכן מתחלפים בקצב שונה: למשל, תאי המעי נשחקים ומוחלפים מהר במיטוזה, ותאי עצב כמעט אינם מוחלפים.","","חשיבה ביקורתית",""],["C","פסקה","","חוקרים גידלו בצלחת מעבדה תא עור אחד. כל תא בצלחת התחלק פעם אחת בכל 12 שעות, לשני תאי בת. התוצאות של 36 השעות הראשונות מוצגות בטבלה 3.","","","","","","",""],["C","טבלה","","טבלה 3: מספר תאי העור בצלחת","הזמן מתחילת הניסוי (שעות)|0|12|24|36 ;; מספר התאים בצלחת|1|2|4|8","","","","","",""],["C","שאלה",10,"אם החלוקות ימשיכו באותו קצב, כמה תאי עור יהיו בצלחת אחרי 48 שעות?","בחירה: 8 | *16 | 24 | 32",4,"","","כל 12 שעות מספר התאים מוכפל. אחרי 48 שעות עברו 4 חלוקות: 1, 2, 4, 8, 16.","פרשנות נתונים",""],["C","יחידה",3,"תאים מתמחים ופלנריה","שאלות 11–14 עוסקות בתא דם אדום, בהתמיינות ובארגון הגוף.","","","","","",""],["C","פסקה","","תא דם אדום בוגר אינו מכיל גרעין, וגם אינו מכיל מיטוכונדריות. הוא מוביל חמצן מהריאות אל כל תאי הגוף. מיטוכונדריות משתמשות בחמצן כדי לשחרר אנרגיה מסוכר.","","","","","","",""],["C","שאלה",11,"איזה יתרון יש בכך שבתא דם אדום אין מיטוכונדריות?","בחירה: *התא אינו צורך את החמצן שהוא מוביל, ולכן כל החמצן מגיע לתאי הגוף. | התא מייצר חמצן בעצמו, ולכן אין לו צורך במיטוכונדריות כמו בשאר התאים. | התא משתמש באנרגיה שמפיק מהחמצן כדי לנוע מהר יותר בתוך כלי הדם. | המיטוכונדריות היו תופסות מקום, והגרעין לא היה מצליח להשתלב בתא.",4,"","","מיטוכונדריות צורכות חמצן. בתא דם אדום אין מיטוכונדריות, ולכן התא אינו צורך את החמצן שהוא מוביל, וכולו מגיע לתאי הגוף.","הסבר תופעות",""],["C","פסקה","","פלנריה היא תולעת שטוחה זעירה החיה בבריכות. כשחותכים אותה לשניים, כל חלק מצמיח את החלק החסר ונעשה פלנריה שלמה. בגוף הפלנריה יש תאי גזע: תאים שמתחלקים, ומתוכם נוצרים תאים מסוגים שונים, כמו תאי עצב, תאי שריר ותאי עור. לכל התאים בגוף הפלנריה אותו חומר תורשתי.","","","","","","",""],["C","שאלה",12,"בחרי מכל רשימה את המילה או את הביטוי המתאימים להשלמת ההסבר: כיצד חלק פלנריה שנחתך מצמיח זנב חדש?","השלמה: תאי הגזע מתחלקים בחלוקה שנקראת {*מיטוזה|מיוזה|הפריה} , ולכן תאי הבת {*זהים לתא האם|שונים מתא האם|מכילים חצי מהכרומוזומים} . אחר כך חלק מהתאים החדשים {*מתמיינים לתאים מסוגים שונים|נשארים בדיוק כמו תאי הגזע|נעלמים מהגוף} , ולמרות שבכולם אותו חומר תורשתי, בכל סוג תא פועל {*חלק אחר מהחומר התורשתי|כל החומר התורשתי באותה מידה|חומר תורשתי אחר לגמרי} .",8,"","","תאי הגזע מתחלקים במיטוזה, שהיא חלוקה של תאי גוף.","הסבר תופעות",""],["C","שאלה",13,"בגוף יש רמות ארגון שונות: תא, רקמה, איבר ומערכת איברים. סמני בכל שורה לאיזו רמת ארגון שייך הפריט.","מטריצה: עמודות=תא|רקמה|איבר|מערכת איברים ;; תא שריר אחד=תא ;; קבוצת תאי שריר דומים שמתכווצים יחד=רקמה ;; השריר הדו-ראשי בזרוע=איבר ;; הכליה=איבר ;; הכליות, השופכנים ושלפוחית השתן שפועלים יחד=מערכת איברים",10,"","","תא הוא היחידה הקטנה ביותר. קבוצת תאים דומים הפועלים יחד היא רקמה. כמה רקמות יוצרות איבר, וכמה איברים הפועלים יחד הם מערכת איברים.","ידע ומודלים",""],["C","פסקה","","בפרסומת לקרם פנים כתוב:","","","","","","",""],["C","פסקה","","<b>\"הקרם שלנו מכיל תאי גזע של פלנריה! הוא מחדש את העור שלך ומצמיח איברים חדשים. הפלנריה הוכיחה את זה!\"</b>","","","","","","",""],["C","שאלה",14,"א. כתבי חולשה אחת בראיה שמוצגת בפרסומת.<br>ב. כתבי מה היה צריך לדעת או לבדוק כדי להעריך אם הקרם באמת מחדש עור.","פתוחה: שורות=3; תווית=א",4,"חולשה אחת מקובלת: ההתחדשות של פלנריה בגוף שלה אינה מוכיחה שקרם על העור של אדם יעבוד. אין נתונים או מחקר על הקרם עצמו. תאי גזע של תולעת שונים מתאי אדם. אין ראיה שהקרם \"מצמיח איברים\". ריק או \"לא יודעת\": 0.","ההתחדשות של פלנריה בגוף שלה אינה מוכיחה שקרם על עור של אדם יעבוד. בפרסומת אין נתונים או מחקר על הקרם עצמו.","","חשיבה ביקורתית",""],["C","שאלה",14,"","פתוחה: שורות=3; תווית=ב",4,"הצעה מתאימה: בדיקה בקבוצה גדולה של אנשים, חלקם עם הקרם וחלקם עם קרם בלי חומר פעיל, ומדידה של התחדשות העור לפני ואחרי. מקובל גם: לברר מי ביצע ומי מימן את הבדיקה. ריק או \"לא יודעת\": 0.","כדאי לבדוק קבוצה גדולה של אנשים, חלקם עם הקרם וחלקם עם קרם בלי חומר פעיל, באותם תנאים, ולמדוד את התחדשות העור לפני ואחרי. וגם לברר מי ביצע ומי מימן את הבדיקה.","","",""]];
